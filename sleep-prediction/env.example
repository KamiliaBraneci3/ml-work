# ─────────────────────────────────────────────
#  Lecture Sleep Predictor — Environment Config
# ─────────────────────────────────────────────

# Number of synthetic student records to generate
N_SAMPLES=2000

# Random seed for full reproducibility
RANDOM_SEED=42

# Train / test split ratio  (0.0 – 1.0)
TEST_SIZE=0.2

# Where to save generated data and trained model
DATA_PATH=data/lecture_data.csv
MODEL_PATH=models/sleep_model.joblib

# Visualisation output directory
PLOT_DIR=plots/
